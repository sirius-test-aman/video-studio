            "y": 0.5925
          }
        }
      ]
    },
    {
      "id": "s14",
      "role": "body",
      "narration": "Choose the document you just pushed, and Velox reads it to pull out every scenario inside.",
      "beats": [
        {
          "screenshot": "step-11.png",
          "caption": "Velox reads the page"
        }
      ]
    },
    {
      "id": "s15",
      "role": "body",
      "narration": "Every scenario it finds is listed with an identifier you will see again further down the pipeline.",
      "beats": [
        {
          "screenshot": "step-12.png",
          "caption": "Each scenario gets an ID"
        }
      ]
    },
    {
      "id": "s16",
      "role": "body",
      "narration": "The prompt is written for you and shown in full, so you can read exactly what your IDE is asked to do.",
      "beats": [
        {
          "screenshot": "step-12.png",
          "caption": "The prompt is shown"
        }
      ]
    },
    {
      "id": "s17",
      "role": "body",
      "narration": "Copy it into Cursor, Claude Code, Copilot or whichever AI IDE you use, and it reads your project code to write the cases.",
      "beats": [
        {

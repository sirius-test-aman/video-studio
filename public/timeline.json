  "captionTrack": [
    {
      "text": "Build a BRD by conversation",
      "role": "body",
      "from": 0,
      "durationInFrames": 242,
      "fadeInFrames": 5
    },
    {
      "text": "Sign in with Azure AD",
      "role": "body",
      "from": 242,
      "durationInFrames": 159,
      "fadeInFrames": 5
    },
    {
      "text": "Modules are listed in the left rail",
      "role": "body",
      "from": 401,
      "durationInFrames": 160,
      "fadeInFrames": 5
    },
    {
      "text": "Open the project picker",
      "role": "body",
      "from": 561,
      "durationInFrames": 146,
      "fadeInFrames": 5
    },
    {
      "text": "See your existing projects",
      "role": "body",
      "from": 707,
      "durationInFrames": 128,
      "fadeInFrames": 5
    },
    {
      "text": "Name it, choose a template, link Atlassian",
      "role": "body",
      "from": 835,
      "durationInFrames": 224,
      "fadeInFrames": 5
    },
    {
      "text": "..or pick an existing project",
      "role": "body",
      "from": 1059,
      "durationInFrames": 100,
      "fadeInFrames": 5
    },
    {
      "text": "Open the BRD Assistant",
      "role": "body",
      "from": 1159,
      "durationInFrames": 167,
      "fadeInFrames": 5
    },
    {
      "text": "Start a new session",
      "role": "body",
      "from": 1326,
      "durationInFrames": 123,
      "fadeInFrames": 5
    },
    {
      "text": "Carry context or start fresh",
      "role": "body",
      "from": 1449,
      "durationInFrames": 182,
      "fadeInFrames": 5
    },
    {
      "text": "Start with a conversation",
      "role": "body",
      "from": 1631,
      "durationInFrames": 184,
      "fadeInFrames": 5
    },
    {
      "text": "Mary drafts the sixteen BRD sections",
      "role": "body",
      "from": 1815,
      "durationInFrames": 237,
      "fadeInFrames": 5
    },
    {
      "text": "Open with what you already know",
      "role": "body",
      "from": 2052,
      "durationInFrames": 202,
      "fadeInFrames": 5
    },
    {
      "text": "Nothing drafts until you press the generate BRD button",
      "role": "body",
      "from": 2254,
      "durationInFrames": 164,
      "fadeInFrames": 5
    },
    {
      "text": "Mary asks for the detail she needs",
      "role": "body",
      "from": 2418,
      "durationInFrames": 155,
      "fadeInFrames": 5
    },
    {
      "text": "Describe your request in plain words",
      "role": "body",
      "from": 2573,
      "durationInFrames": 157,
      "fadeInFrames": 5
    },
    {
      "text": "Mary builds context question by question",
      "role": "body",
      "from": 2730,
      "durationInFrames": 175,
      "fadeInFrames": 5
    },
    {
      "text": "Answer as you would in a call",
      "role": "body",
      "from": 2905,
      "durationInFrames": 148,
      "fadeInFrames": 5
    },
    {
      "text": "Separate issues stay separate",
      "role": "body",
      "from": 3053,
      "durationInFrames": 152,
      "fadeInFrames": 5
    },
    {
      "text": "Describe the process end to end",
      "role": "body",
      "from": 3205,
      "durationInFrames": 160,
      "fadeInFrames": 5
    },
    {
      "text": "Correct her understanding early",
      "role": "body",
      "from": 3365,
      "durationInFrames": 150,
      "fadeInFrames": 5
    },
    {
      "text": "Facts are recorded as you talk",
      "role": "body",
      "from": 3515,
      "durationInFrames": 174,
      "fadeInFrames": 5
    },
    {
      "text": "Cover scope, constraints and edge cases",
      "role": "body",
      "from": 3689,
      "durationInFrames": 171,
      "fadeInFrames": 5
    },
    {
      "text": "Every saved fact is visible",
      "role": "body",
      "from": 3860,
      "durationInFrames": 146,
      "fadeInFrames": 5
    },
    {
      "text": "Generate whenever you are ready",
      "role": "body",
      "from": 4006,
      "durationInFrames": 182,
      "fadeInFrames": 5
    },
    {
      "text": "Velox drafts each section in turn",
      "role": "body",
      "from": 4188,
      "durationInFrames": 166,
      "fadeInFrames": 5
    },
    {
      "text": "Sixteen sections drafted",
      "role": "body",
      "from": 4354,
      "durationInFrames": 162,
      "fadeInFrames": 5
    },
    {
      "text": "Edit inline or refine by chat",
      "role": "body",
      "from": 4516,
      "durationInFrames": 139,
      "fadeInFrames": 5
    },
    {
      "text": "Download or send to Confluence",
      "role": "body",
      "from": 4655,
      "durationInFrames": 164,
      "fadeInFrames": 5
    },
    {
      "text": "Written with you, not for you",
      "role": "outro",
      "from": 4819,
      "durationInFrames": 174,
      "fadeInFrames": 5
    }
  ],
